# Projeto Supabase usado pela nuvem (Project Settings → API).
# A chave publicável pode ir para o navegador: quem protege os dados é a RLS.
# NUNCA coloque aqui a chave secreta (service_role / sb_secret_...).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Google Drive (Google Cloud → APIs e serviços). Todos públicos por natureza:
# ficam restritos às origens do app no Google Cloud.
# NUNCA coloque aqui a chave secreta do cliente (GOCSPX-...).
VITE_GOOGLE_CLIENT_ID=123456789012-xxxx.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIzaSy...
# Número do projeto no Google Cloud (o seletor de arquivos pede)
VITE_GOOGLE_APP_ID=123456789012
